---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---

<Base title="Thank You">
  <section class="max-w-md mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="mx-auto w-14 h-14 rounded-full bg-green-600 flex items-center justify-center">
      <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
        stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"></path></svg>
    </div>
    <h1 class="mt-6 text-2xl font-bold text-gray-900 dark:text-slate-100">Thank You!</h1>
    <p class="mt-3 text-gray-600 dark:text-slate-400 leading-relaxed">
      Your message has been sent. I'll get back to you as soon as I can.
    </p>
    <div class="mt-8"><Button href="/">Return to Home</Button></div>
  </section>
</Base>
