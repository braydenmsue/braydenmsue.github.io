---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { getSortedPosts, getSortedProjects } from "../lib/content";
import { getTopAlbums } from "../lib/spotify";
import { BIO, NAME, TITLE } from "../site";

const featuredProjects = (await getSortedProjects()).slice(0, 3);
const recentPosts = (await getSortedPosts()).slice(0, 3);
const topAlbums = await getTopAlbums();
---

<Base>
  <!-- Hero -->
  <section class="bg-gray-200/70 dark:bg-slate-900 px-4 sm:px-6 py-20 sm:py-28 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 dark:text-slate-100 tracking-tight">{NAME}</h1>
    <p class="mt-3 text-xl text-gray-600 dark:text-slate-400">{TITLE}</p>
    <p class="mt-6 max-w-xl mx-auto text-gray-600 dark:text-slate-400 leading-relaxed">{BIO}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <Button href="/projects/">View Projects</Button>
      <Button href="/contact/" variant="ghost">Get in Touch</Button>
    </div>
  </section>

  <!-- Featured projects -->
  {
    featuredProjects.length > 0 && (
      <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
        <SectionHeading>Featured Projects</SectionHeading>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
        <p class="mt-8 text-center">
          <a href="/projects/" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">All projects →</a>
        </p>
      </section>
    )
  }

  <!-- Writing + Spotify -->
  <section class="bg-gray-100 dark:bg-slate-900/50 border-y border-gray-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 grid gap-12 lg:grid-cols-2">
      <div>
        <div class="flex items-baseline justify-between mb-5">
          <h2 class="text-xl font-bold text-gray-900 dark:text-slate-100">Recent Writing</h2>
          <a href="/blog/" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">All posts →</a>
        </div>
        {
          recentPosts.length > 0 ? (
            <PostList posts={recentPosts} size="compact" />
          ) : (
            <p class="text-sm text-gray-500 dark:text-slate-500">No posts yet.</p>
          )
        }
      </div>

      <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-slate-100 mb-5">Currently Listening To</h2>
        {
          topAlbums.length > 0 ? (
            <div class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-3 gap-3">
              {topAlbums.map((album) => (
                <a href={album.spotifyUrl} target="_blank" rel="noopener noreferrer" class="group block min-w-0">
                  {album.imageUrl ? (
                    <img
                      src={album.imageUrl}
                      alt={album.name}
                      loading="lazy"
                      class="w-full aspect-square object-cover rounded-lg mb-2 shadow-sm group-hover:opacity-90 transition-opacity"
                    />
                  ) : (
                    <div class="w-full aspect-square bg-gray-200 dark:bg-slate-800 rounded-lg mb-2 flex items-center justify-center text-gray-400 dark:text-slate-600 text-xs">
                      no art
                    </div>
                  )}
                  <p class="text-xs font-medium text-gray-800 dark:text-slate-200 truncate">{album.name}</p>
                  <p class="text-xs text-gray-500 dark:text-slate-500 truncate">{album.artist}</p>
                </a>
              ))}
            </div>
          ) : (
            <p class="text-sm text-gray-500 dark:text-slate-500">Spotify data unavailable.</p>
          )
        }
      </div>
    </div>
  </section>
</Base>
